// ===========================================================================
// USER PREFERENCES - each person's own display choices (today: light or dark theme).
//
// One row per person, created the first time they choose. No row means "never chose", which the app shows as LIGHT.
// NEW TABLE ONLY: no column was added to users. A database without this table keeps working exactly as before; the
// screen then remembers the choice in the browser only. No Prisma relation to User on purpose (the foreign key lives
// in the migration SQL).
// ===========================================================================

model UserPreference {
  userId String @id @db.Uuid // = users.id
  theme  String @default("LIGHT") // LIGHT | DARK (CHECK constraint in the migration)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}
