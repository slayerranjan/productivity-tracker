// ===========================================================================
// HIRING & ONBOARDING — offer letters, documents, induction
//
// DATA PROTECTION
// These tables hold identity documents (Aadhaar, PAN, certificates), which
// makes this a personal-data store under India's DPDP Act 2023:
//   - files live in private storage, served only via short-lived signed URLs
//   - read access limited to the owner, HR and ADMIN
//   - retentionUntil is set on exit; a scheduled job deletes after it
//   - consentAcceptedAt is recorded at the moment of upload
// ===========================================================================

// An editable letter template per platform. Placeholders like {{firstName}}
// are replaced when an offer is generated.
model OfferTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  platformId String   @db.Uuid
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  name        String // "Sales Executive — standard"
  subject     String // email subject line
  bodyHtml    String // the letter itself, with placeholders
  emailIntro  String? // short covering note in the email body

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]

  @@unique([platformId, name])
  @@map("offer_templates")
}

model Offer {
  id         String   @id @default(uuid()) @db.Uuid
  platformId String   @db.Uuid
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  // The candidate. A User row exists from the moment the offer is created,
  // with status CANDIDATE, so they can log in and upload documents.
  candidateId String @db.Uuid
  candidate   User   @relation("OfferCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  templateId String?        @db.Uuid
  template   OfferTemplate? @relation(fields: [templateId], references: [id])

  // Snapshot of the filled-in values, kept so the record never changes even
  // if the template is edited later.
  roleTitle     String
  joiningDate   DateTime  @db.Date
  ctcAnnual     Decimal?  @db.Decimal(12, 2)
  reportingTo   String?
  renderedHtml  String
  pdfStorageKey String?

  status    OfferStatus @default(DRAFT)
  sentAt    DateTime?
  expiresAt DateTime?

  // Acceptance trail — without this there is no record that they said yes
  respondedAt    DateTime?
  responseIp     String?
  declineReason  String?

  sentById String? @db.Uuid
  sentBy   User?   @relation("OfferSender", fields: [sentById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId, status])
  @@index([candidateId])
  @@map("offers")
}

// What HR requires from a joiner. Configurable, so a new requirement does
// not need a code change.
model DocumentRequirement {
  id         String   @id @default(uuid()) @db.Uuid
  platformId String   @db.Uuid
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  category DocumentCategory
  label    String // "Aadhaar card (front and back)"
  helpText String?

  isMandatory Boolean @default(true)
  sortOrder   Int     @default(0)

  // false means HR uploads it (resume, contract)
  uploadedByEmployee Boolean @default(true)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@unique([platformId, label])
  @@index([platformId, isActive])
  @@map("document_requirements")
}

model EmployeeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  platformId String   @db.Uuid
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)

  requirementId String?              @db.Uuid
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id])

  category DocumentCategory
  status   DocumentStatus   @default(REQUESTED)

  // Storage key only — never a public URL. Signed on read.
  storageKey   String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  uploadedAt   DateTime?
  uploadedById String?   @db.Uuid // HR's id when HR uploaded it

  reviewedById    String?   @db.Uuid
  reviewedBy      User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // DPDP
  consentAcceptedAt DateTime?
  retentionUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
  @@index([platformId, status])
  @@map("employee_documents")
}

// Company reading material — induction decks, probation and leave policies.
model InductionDocument {
  id         String   @id @default(uuid()) @db.Uuid
  platformId String   @db.Uuid
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  category    InductionCategory
  title       String
  description String?

  storageKey String
  fileName   String
  fileSize   Int?
  mimeType   String?

  isMandatory Boolean @default(true)
  sortOrder   Int     @default(0)

  // Optional: restrict to one team, otherwise platform-wide
  teamId String? @db.Uuid

  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgements InductionAcknowledgement[]

  @@index([platformId, isActive])
  @@map("induction_documents")
}

// Proof the employee opened and confirmed each required document.
// This is the row an audit asks for.
model InductionAcknowledgement {
  id String @id @default(uuid()) @db.Uuid

  inductionDocumentId String            @db.Uuid
  inductionDocument   InductionDocument @relation(fields: [inductionDocumentId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A new version of a document requires a fresh acknowledgement
  documentVersion Int

  openedAt       DateTime?
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([inductionDocumentId, userId, documentVersion])
  @@index([userId])
  @@map("induction_acknowledgements")
}
